{
  "manifest_version": 3,
  "name": "AccessLens – WCAG Auditor",
  "version": "2.0.0",
  "description": "Full WCAG 2.2 audit: contrast, alt text, headings, landmarks, focus management, ARIA tooltip inspector, and live overlay.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup-dist/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}